# Template for secrets.properties.
#
# To set up: copy this file to `secrets.properties` and fill in your own keys.
#   cp secrets.properties.example secrets.properties
#
# `secrets.properties` is git-ignored and must never be committed.
# This `.example` file IS committed, so anyone cloning the repo knows what keys
# are needed. Do not put real keys here.

# Pexels API key — https://www.pexels.com/api/  (free)
pexelsApiKey=

# Anthropic API key — https://console.anthropic.com/  (used later for AI features)
anthropicApiKey=
